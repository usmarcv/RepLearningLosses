                "--learning_rate", "0.001",
                "--dataset", "path",
                "--data_folder", "./PlatonicSolidsImages",
                "--mean", "(0.4914, 0.4822, 0.4465)",
                "--std", "(0.2675, 0.2565, 0.2761)",
                "--method", "SimCLR",
                "--num_workers", "18", //notebook dell
                "--warm",
                "--cosine"
            ],
            "justMyCode": false
        }
    ]
}

